---
/**
 * Hero desta LP — DESVIO da estrutura fixa (PROMPT-PADRAO-LP 4.1.2), pedido pelo
 * cliente da agência em 29/10/2026 com o mockup do topo (registro em docs/BRIEFING.md).
 *
 * Diferenças para o padrão: sem a coluna de 300px do chat (o shortcode do chat não é
 * renderizado aqui; o do formulário segue na Cotação), banner em largura total ancorado
 * à direita, e a faixa "Encontre a linha" no pé do hero, com um card-CTA por linha.
 *
 * Banner (src/assets/heroBg.png, 1981×891): lado esquerdo já em navy #002146 — a mesma
 * cor do fundo da seção, para não haver emenda quando a foto não cobre a largura toda.
 */
import { Picture } from 'astro:assets'
import Icon from './Icon.astro'
import { hero, cta } from '../data/content'
---

<section class="hero relative overflow-hidden text-neutral-light" data-hero>
  <div class="relative flex flex-col lg:block lg:min-h-[42rem]">
    {/* Banner — no mobile, bloco abaixo do texto; no desktop, fundo da área do texto */}
    <div class="hero-media relative order-2 -mt-4 h-60 sm:h-80 lg:absolute lg:inset-y-0 lg:mt-0 lg:h-auto">
      <Picture
        src={hero.banner.src}
        alt={hero.banner.alt}
        widths={[640, 1024, 1536, 1981]}
        sizes="100vw"
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="h-full w-full object-cover object-[80%_50%] lg:object-[100%_50%]"
        pictureAttributes={{ class: 'block h-full w-full' }}
      />
      <div class="hero-veil pointer-events-none absolute inset-0" aria-hidden="true"></div>
    </div>

    {/* Texto */}
    <div class="relative z-[2] order-1 mx-auto w-full max-w-page px-6 pt-28 pb-8 sm:pt-32 lg:px-10 lg:pt-36 lg:pb-10">
      <div class="max-w-[50rem]">
        <span class="inline-flex items-center gap-4 font-sans text-[12px] font-semibold tracking-[0.18em] text-neutral-light/85 uppercase sm:text-[13px]">
          <span class="hero-dash h-[3px] w-8 shrink-0 rounded-full" aria-hidden="true"></span>
          {hero.eyebrow}
        </span>

        <h1 class="mt-5 font-display text-[2.5rem] leading-[1.05] font-extrabold tracking-[-0.025em] text-neutral-light sm:text-[3.25rem] lg:text-[3.4rem] xl:text-[3.9rem]">
          {hero.title}
        </h1>

        <p class="mt-6 max-w-[37rem] font-sans lg:max-w-[33rem] text-[16px] leading-relaxed text-neutral-light/80 sm:text-[17px] lg:text-[18px]">
          {hero.text}
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-x-10 gap-y-5">
          <button
            type="button"
            data-cta="hero-primary"
            class="btn-slave-whats inline-flex items-center gap-3 rounded-lg border border-white/15 bg-accent-orange px-8 py-4 font-sans text-[16px] font-bold text-neutral-light shadow-[inset_0_1px_0_rgba(255,255,255,0.18),0_16px_32px_-16px_rgba(0,0,0,0.8)] transition-colors duration-200 hover:bg-accent-orange-dark sm:text-[17px]"
          >
            {cta.primary}
            <Icon name="arrow-right" class="size-[18px] shrink-0" />
          </button>

          <a
            href="#linhas"
            data-cta="hero-secondary"
            class="hero-link group inline-flex items-center gap-3 border-b border-neutral-light/45 pb-1.5 font-sans text-[16px] font-semibold text-neutral-light transition-colors duration-200 hover:border-neutral-light"
          >
            {cta.findLine}
            <Icon name="arrow-down" class="hero-link-arrow size-4 shrink-0" />
          </a>
        </div>

        <div class="mt-7 flex items-start gap-4">
          <Icon name="chat" class="hero-green mt-0.5 size-8 shrink-0" />
          <p class="font-sans text-[15px] leading-snug text-neutral-light/80 sm:text-[16px]">
            <strong class="block font-bold text-neutral-light">{hero.help.title}</strong>
            {hero.help.text}
          </p>
        </div>
      </div>
    </div>
  </div>

  {/* Faixa "Encontre a linha" — cada card é um CTA */}
  <div class="hero-strip relative z-[2] border-t border-white/10">
    <div class="mx-auto max-w-page px-6 pt-8 pb-7 lg:px-10 lg:pt-7">
      <h2 class="font-display text-[1.4rem] leading-tight font-extrabold text-neutral-light sm:text-[1.6rem]">
        {hero.lines.title}
      </h2>

      <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" aria-label={hero.lines.title}>
        {hero.lines.items.map((line) => (
          <li class="flex">
            <button
              type="button"
              data-cta={`hero-linha-${line.id}`}
              class="btn-slave-whats hero-card group grid w-full grid-cols-[3.5rem_minmax(0,1fr)] content-start items-center gap-x-4 gap-y-3.5 rounded-xl border border-white/15 bg-white/[0.03] p-5 text-left transition-[border-color,background-color] duration-300 hover:border-white/35 hover:bg-white/[0.07]"
            >
              <span class="flex size-14 items-center justify-center rounded-lg border border-white/20 bg-white/[0.04]">
                <Icon name={line.icon} class="hero-green size-7" />
              </span>

              <span class="min-w-0">
                <span class="block font-display text-[19px] leading-tight font-extrabold text-neutral-light">
                  {line.title}
                </span>
                <span class="mt-1 flex flex-wrap items-center font-sans text-[13px] font-semibold text-neutral-light/80">
                  {line.spec.map((part) => (
                    <span class="hero-spec">{part}</span>
                  ))}
                </span>
              </span>

              <span class="col-span-2 flex items-end justify-between gap-4">
                <span class="font-sans text-[14px] leading-snug text-neutral-light/70">
                  {line.description}
                </span>
                <Icon
                  name="arrow-right"
                  class="hero-card-arrow size-5 shrink-0 text-neutral-light/85"
                />
              </span>
            </button>
          </li>
        ))}
      </ul>

      <p class="mt-4 font-sans text-[12.5px] text-neutral-light/55">{hero.lines.note}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    /* Navy do lado esquerdo do banner: o fundo da seção continua a foto sem emenda. */
    --hero-navy: #002146;
    --hero-green: #7ba249;
    --page-half: calc(var(--container-page) / 2);
    --page-edge: max(0px, calc(50% - var(--page-half)));
    background-color: var(--hero-navy);
  }

  .hero-dash {
    background-color: var(--hero-green);
  }

  /* "Até 1.567 CFM | até 30 bar": divisória entre os dados da mesma linha. */
  .hero-spec + .hero-spec {
    margin-left: 0.625rem;
    padding-left: 0.625rem;
    border-left: 1px solid rgb(255 255 255 / 0.4);
  }

  /* Ícones vêm do componente Icon: o seletor precisa alcançar o <svg> dele. */
  .hero :global(.hero-green) {
    color: var(--hero-green);
  }

  .hero-strip {
    background-color: rgb(0 27 60);
  }

  /* Mobile: a foto vem depois do texto e se funde a ele no topo e à faixa na base. */
  .hero-veil {
    background:
      linear-gradient(to bottom, var(--hero-navy) 0%, rgb(0 33 70 / 0) 38%),
      linear-gradient(to top, rgb(0 27 60) 0%, rgb(0 27 60 / 0) 30%);
  }

  @media (min-width: 1024px) {
    /* Foto ancorada à direita da tela; à esquerda, recua até perto da borda do container */
    /* para os compressores ficarem à direita do texto em qualquer largura. */
    .hero-media {
      left: max(0px, calc(var(--page-edge) - 7.5rem));
      right: 0;
    }

    .hero-veil {
      background:
        linear-gradient(
          to right,
          var(--hero-navy) 0%,
          rgb(0 33 70 / 0.85) 30%,
          rgb(0 33 70 / 0.5) 45%,
          rgb(0 33 70 / 0) 62%
        ),
        linear-gradient(to bottom, rgb(0 33 70 / 0.55) 0%, rgb(0 33 70 / 0) 22%),
        linear-gradient(to top, rgb(0 27 60 / 0.85) 0%, rgb(0 27 60 / 0) 24%);
    }
  }

  .hero :global(.hero-link-arrow),
  .hero :global(.hero-card-arrow) {
    transition: transform 250ms ease;
  }

  .hero-link:hover :global(.hero-link-arrow) {
    transform: translateY(3px);
  }

  .hero-card:hover :global(.hero-card-arrow) {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero :global(.hero-link-arrow),
    .hero :global(.hero-card-arrow) {
      transition: none;
    }

    .hero-link:hover :global(.hero-link-arrow),
    .hero-card:hover :global(.hero-card-arrow) {
      transform: none;
    }
  }
</style>
