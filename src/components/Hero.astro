---
/**
 * Hero desta LP — DESVIO da estrutura fixa (PROMPT-PADRAO-LP 4.1.2), pedido pela B2
 * em 29/10/2026 com o mockup do topo (registro em docs/BRIEFING.md).
 *
 * Diferenças para o padrão: fundo claro em vez do navy, duas colunas (texto · foto em
 * card arredondado), sem a coluna de 300px do chat (o shortcode do chat não é renderizado
 * aqui; o do formulário segue na Cotação), e a faixa "Encontre a linha" no pé do hero,
 * com um CTA por linha.
 *
 * Foto (src/assets/heroBg.png, 1020×721): recorte do banner entregue com o mockup, só
 * com a pedreira e os compressores. No desktop o card sangra até perto da borda da tela.
 */
import { Picture } from 'astro:assets'
import Icon from './Icon.astro'
import { hero, cta } from '../data/content'

const [titleStart, titleEnd = ''] = hero.title.split(hero.highlight)
const hasHighlight = hero.title.includes(hero.highlight)
---

<section class="hero relative overflow-hidden rounded-b-[2rem] sm:rounded-b-[3rem]" data-hero>
  <div class="mx-auto max-w-page px-6 pt-28 pb-12 sm:pt-32 lg:px-10 lg:pt-36 lg:pb-14">
    <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1.12fr)_minmax(0,1fr)] lg:gap-8">
      {/* Texto */}
      <div>
        <span class="inline-flex items-center gap-4 font-sans text-[12px] font-semibold tracking-[0.18em] text-primary-dark-900 uppercase sm:text-[13px]">
          <span
            class="h-[3px] w-9 shrink-0 rounded-full bg-accent-orange"
            aria-hidden="true"
          ></span>
          {hero.eyebrow}
        </span>

        <h1 class="mt-5 font-display text-[2.4rem] leading-[1.06] font-extrabold tracking-[-0.025em] text-primary-dark-900 sm:text-[3rem] lg:text-[2.6rem] xl:text-[3.3rem]">
          {hasHighlight ? (
            <>
              {titleStart}
              <span class="text-accent-orange">{hero.highlight}</span>
              {titleEnd}
            </>
          ) : (
            hero.title
          )}
        </h1>

        <p class="mt-6 max-w-[36rem] font-sans text-[16px] leading-relaxed text-ink-soft sm:text-[17px] lg:text-[18px]">
          {hero.text}
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-x-10 gap-y-5">
          <button
            type="button"
            data-cta="hero-primary"
            class="btn-slave-whats inline-flex items-center gap-3 rounded-lg bg-accent-orange px-8 py-4 font-sans text-[16px] font-bold text-neutral-light shadow-[0_16px_30px_-16px_rgba(77,127,34,0.9)] transition-colors duration-200 hover:bg-accent-orange-dark sm:text-[17px]"
          >
            {cta.primary}
            <Icon name="arrow-right" class="size-[18px] shrink-0" />
          </button>

          <a
            href="#linhas"
            data-cta="hero-secondary"
            class="group inline-flex items-center gap-3 border-b border-primary-dark-900/45 pb-1.5 font-sans text-[16px] font-semibold text-primary-dark-900 transition-colors duration-200 hover:border-accent-orange hover:text-accent-orange"
          >
            {cta.findLine}
            <Icon
              name="arrow-down"
              class="size-4 shrink-0 transition-transform duration-200 group-hover:translate-y-0.5 motion-reduce:transition-none motion-reduce:group-hover:translate-y-0"
            />
          </a>
        </div>

        <div class="mt-7 flex items-start gap-4">
          <Icon name="chat" class="mt-0.5 size-8 shrink-0 text-primary-dark-900" />
          <p class="font-sans text-[15px] leading-snug text-ink-soft sm:text-[16px]">
            <strong class="block font-bold text-primary-dark-900">{hero.help.title}</strong>
            {hero.help.text}
          </p>
        </div>
      </div>

      {/* Foto em card arredondado */}
      <div class="hero-photo relative">
        <Picture
          src={hero.banner.src}
          alt={hero.banner.alt}
          widths={[...hero.banner.widths]}
          sizes={hero.banner.sizes}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="aspect-[1.415] h-auto w-full rounded-[1.5rem] object-cover lg:aspect-[1.5] lg:rounded-[1.75rem]"
          pictureAttributes={{ class: 'block' }}
        />
      </div>
    </div>
  </div>

  {/* Faixa "Encontre a linha" — cada linha é um CTA */}
  <div class="hero-strip border-t border-primary-dark/10">
    <div class="mx-auto max-w-page px-6 pt-7 pb-7 lg:px-10">
      <h2 class="font-display text-[1.4rem] leading-tight font-extrabold text-primary-dark-900 sm:text-[1.6rem]">
        {hero.lines.title}
      </h2>

      <ul
        class="mt-5 grid gap-y-6 sm:grid-cols-2 sm:gap-x-8 lg:grid-cols-4 lg:gap-x-0"
        aria-label={hero.lines.title}
      >
        {hero.lines.items.map((line) => (
          <li class="flex lg:border-l lg:border-primary-dark/10 lg:px-6 xl:px-7 lg:first:border-l-0 lg:first:pl-0 lg:last:pr-0">
            <button
              type="button"
              data-cta={`hero-linha-${line.id}`}
              class="btn-slave-whats group grid w-full grid-cols-[3.5rem_minmax(0,1fr)] content-start items-center gap-x-4 gap-y-3 text-left"
            >
              <span class="flex size-14 items-center justify-center rounded-xl border border-primary-dark/10 bg-neutral-light shadow-[0_6px_16px_-10px_rgba(10,29,77,0.35)] transition-colors duration-200 group-hover:border-accent-orange/50">
                <Icon name={line.icon} class="size-7 text-accent-orange" />
              </span>

              <span class="min-w-0">
                <span class="block font-display text-[19px] leading-tight font-extrabold text-primary-dark-900 transition-colors duration-200 group-hover:text-accent-orange">
                  {line.title}
                </span>
                <span class="mt-1 flex flex-wrap items-center font-sans text-[13.5px] font-medium text-ink-soft">
                  {line.spec.map((part) => (
                    <span class="hero-spec">{part}</span>
                  ))}
                </span>
              </span>

              <span class="col-span-2 flex items-end justify-between gap-3">
                <span class="font-sans text-[14px] leading-snug text-ink-soft">
                  {line.description}
                </span>
                <Icon
                  name="arrow-right"
                  class="size-5 shrink-0 text-primary-dark-900 transition-transform duration-200 group-hover:translate-x-0.5 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0"
                />
              </span>
            </button>
          </li>
        ))}
      </ul>

      <p class="mt-5 font-sans text-[12.5px] text-ink-soft/80">{hero.lines.note}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    /* Distância entre o container e a borda da tela (vw: a referência é a tela, não a coluna). */
    --page-edge: max(0px, calc((100vw - var(--container-page)) / 2));
    background:
      radial-gradient(1100px 560px at 12% 0%, rgb(255 255 255 / 0.9) 0%, transparent 60%),
      linear-gradient(180deg, #edf2f8 0%, #f4f7fb 100%);
  }

  .hero-strip {
    background-color: #f4f7fb;
  }

  .hero-photo :global(img) {
    box-shadow: 0 34px 60px -34px rgb(10 29 77 / 0.55);
  }

  /* No desktop a foto sangra até 24px da borda da tela, como no mockup. */
  @media (min-width: 1024px) {
    .hero-photo {
      margin-right: calc(-1 * (var(--page-edge) + 2.5rem) + 1.5rem);
    }
  }

  /* "Até 1.567 CFM | até 30 bar": divisória entre os dados da mesma linha. */
  .hero-spec + .hero-spec {
    margin-left: 0.625rem;
    padding-left: 0.625rem;
    border-left: 1px solid rgb(10 29 77 / 0.3);
  }
</style>
