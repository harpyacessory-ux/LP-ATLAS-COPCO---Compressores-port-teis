---
/**
 * Painel de apoio à identificação — fase "apoio" da biblioteca B2, com o layout do
 * mockup de 29/10/2026 nesta LP (desvio registrado em docs/BRIEFING.md).
 * `npm run compose` sobrescreve este arquivo com o da biblioteca: guarde-o antes.
 *
 * Card dividido a partir de 1280px (abaixo, empilhado): bloco navy à esquerda (título, texto, CTA e reforço) — continua sendo
 * o bloco navy da primeira metade da página — e, à direita, os 6 dados em dois grupos:
 * o essencial e o "se souber" (`list.optionalFrom`).
 */
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import type { SectionProps } from '@lib/layout'
import { supportPanel } from '@data/sections/identificar'

type Props = SectionProps

const { tone, rhythm } = Astro.props
const { list } = supportPanel
const [main, ...essentials] = supportPanel.items.slice(0, list.optionalFrom)
const optionals = supportPanel.items.slice(list.optionalFrom)
---

<Section id="identificar" tone={tone} rhythm={rhythm}>
  <div class="grid overflow-hidden rounded-[1.5rem] border border-primary-dark/10 bg-neutral-light shadow-[0_30px_60px_-36px_rgba(10,29,77,0.45)] xl:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
    {/* Bloco navy */}
    <div class="support-navy flex flex-col justify-center px-6 py-10 sm:px-10 sm:py-12 xl:px-14 xl:py-14">
      <span class="inline-flex items-center gap-4 font-sans text-[12px] font-semibold tracking-[0.16em] text-neutral-light/70 uppercase sm:text-[13px]">
        <span class="h-[3px] w-8 shrink-0 rounded-full bg-accent-orange" aria-hidden="true"></span>
        {supportPanel.eyebrow}
      </span>

      <h2 class="mt-4 max-w-[26rem] font-display text-[2.2rem] leading-[1.06] font-extrabold tracking-[-0.02em] text-neutral-light sm:text-[2.75rem] xl:text-[3.1rem]">
        {supportPanel.title}
      </h2>

      <p class="mt-5 max-w-[30rem] font-sans text-[16px] leading-relaxed text-neutral-light/80 sm:text-[18px]">
        {supportPanel.text}
      </p>

      <button
        type="button"
        data-cta="identificar-cta"
        class="btn-slave-whats mt-8 flex w-full max-w-[30rem] items-center justify-center gap-4 rounded-lg bg-accent-orange px-6 py-4 font-sans text-[17px] font-bold text-neutral-light shadow-[0_18px_34px_-18px_rgba(0,0,0,0.8)] transition-colors duration-200 hover:bg-accent-orange-dark sm:text-[19px]"
      >
        {supportPanel.ctaLabel}
        <Icon name="arrow-right" class="size-5 shrink-0" />
      </button>

      <p class="mt-6 flex items-center gap-3 font-sans text-[14px] text-neutral-light/70 sm:text-[15px]">
        <Icon name="chat" class="size-6 shrink-0 text-neutral-light/85" />
        {supportPanel.microcopy}
      </p>
    </div>

    {/* Lado claro: o que enviar */}
    <div class="px-6 py-10 sm:px-10 sm:py-12 xl:px-12 xl:py-12">
      <h3 class="font-display text-[1.6rem] leading-tight font-extrabold text-primary-dark-900 sm:text-[2rem]">
        {list.title}
      </h3>
      <p class="mt-2 font-sans text-[15px] leading-snug text-ink-soft sm:text-[17px]">
        {list.text}
      </p>

      <ul
        class="mt-6 grid gap-4 sm:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)]"
        aria-label={list.title}
      >
        <li class="support-card flex items-center gap-5 px-5 py-5 sm:col-span-2 sm:px-6">
          <span class="support-badge size-16">
            <Icon name={main.icon} class="size-8" />
          </span>
          <span class="flex min-w-0 flex-col gap-1">
            <span class="font-display text-[17px] font-extrabold text-primary-dark-900">
              {main.label}
            </span>
            <span class="font-sans text-[15px] leading-snug text-ink-soft">{main.hint}</span>
          </span>
        </li>
        {essentials.map((item) => (
          <li class="support-card flex items-center gap-4 px-5 py-4">
            <span class="support-badge size-14">
              <Icon name={item.icon} class="size-7" />
            </span>
            <span class="flex min-w-0 flex-col gap-1">
              <span class="font-display text-[16px] font-extrabold text-primary-dark-900">
                {item.label}
              </span>
              <span class="font-sans text-[14px] leading-snug text-ink-soft">{item.hint}</span>
            </span>
          </li>
        ))}
      </ul>

      <div class="mt-6 flex items-center gap-4" aria-hidden="true">
        <span class="font-sans text-[14px] font-semibold text-ink-soft">{list.optionalLabel}</span>
        <span class="h-px flex-1 bg-primary-dark/12"></span>
      </div>

      <ul class="mt-4 grid gap-4 sm:grid-cols-3" aria-label={list.optionalLabel}>
        {optionals.map((item) => (
          <li class="support-card flex items-center gap-3.5 px-4 py-4">
            <span class="support-badge size-12">
              <Icon name={item.icon} class="size-6" />
            </span>
            <span class="flex min-w-0 flex-col gap-0.5">
              <span class="font-display text-[16px] font-extrabold text-primary-dark-900">
                {item.label}
              </span>
              <span class="font-sans text-[14px] leading-snug text-ink-soft">{item.hint}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Section>

<style>
  .support-navy {
    background:
      radial-gradient(700px 420px at 0% 0%, rgb(255 255 255 / 0.06) 0%, transparent 60%),
      linear-gradient(160deg, var(--color-primary-dark-900) 0%, #071634 100%);
  }

  .support-card {
    border: 1px solid rgb(10 29 77 / 0.1);
    border-radius: 0.875rem;
    background-color: #f6f8fb;
  }

  .support-badge {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background-color: rgb(10 29 77 / 0.06);
    color: var(--color-primary-dark-900);
  }
</style>
