---
/**
 * Header desta LP — DESVIO da estrutura fixa (PROMPT-PADRAO-LP 4.1.1), pedido pela B2
 * em 29/10/2026 com o mockup do topo (registro em docs/BRIEFING.md).
 *
 * Barra branca flutuante e fixa: logo colorido, duas âncoras (Compressores, Aplicações)
 * e CTA verde. A sombra cresce quando a página rola (data-scrolled).
 */
import { Image } from 'astro:assets'
import Icon from './Icon.astro'
import logo from '../assets/marca-safe-mine.png'
import { site } from '../data/site'
import { header, cta } from '../data/content'
---

<header class="fixed inset-x-0 top-0 z-50 pt-3 sm:pt-4 lg:pt-5" data-header>
  <div class="mx-auto max-w-page px-3 sm:px-5 lg:px-8">
    <div class="site-bar flex items-center justify-between gap-4 rounded-2xl border border-primary-dark/10 bg-neutral-light px-4 py-2.5 sm:px-6 sm:py-3 lg:px-7">
      {/* 1. Logo */}
      <a href="/" class="flex shrink-0 items-center" aria-label={site.brand}>
        <Image
          src={logo}
          alt={site.brand}
          width={420}
          format="webp"
          loading="eager"
          fetchpriority="low"
          decoding="async"
          class="h-8 w-auto sm:h-10"
        />
      </a>

      {/* 2. Âncoras + CTA verde (rótulo curto no mobile) */}
      <div class="flex items-center gap-8 lg:gap-12">
        <nav class="hidden items-center gap-8 md:flex lg:gap-12" aria-label="Seções da página">
          {header.nav.map((link) => (
            <a
              href={link.href}
              data-cta={`header-${link.id}`}
              class="font-sans text-[15px] font-medium text-ink transition-colors duration-200 hover:text-accent-orange"
            >
              {link.label}
            </a>
          ))}
        </nav>

        <button
          type="button"
          data-cta="header-cta"
          class="btn-slave-whats inline-flex shrink-0 items-center gap-2.5 rounded-lg bg-accent-orange px-4 py-2.5 font-sans text-[13px] font-bold text-neutral-light shadow-[0_10px_22px_-12px_rgba(77,127,34,0.9)] transition-colors duration-200 hover:bg-accent-orange-dark sm:px-6 sm:py-3 sm:text-[15px]"
        >
          <span class="sm:hidden">{cta.primaryShort}</span>
          <span class="hidden sm:inline">{cta.primary}</span>
          <Icon name="arrow-right" class="hidden size-4 shrink-0 sm:block" />
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .site-bar {
    box-shadow: 0 12px 32px -20px rgb(10 29 77 / 0.35);
    transition: box-shadow 300ms ease;
  }

  [data-header][data-scrolled] .site-bar {
    box-shadow: 0 16px 40px -18px rgb(10 29 77 / 0.5);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-bar {
      transition: none;
    }
  }
</style>

<style is:global>
  /* O header é fixo: âncoras param abaixo dele. */
  html {
    scroll-padding-top: 6.5rem;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-header]').forEach((el) => {
    const update = () => el.toggleAttribute('data-scrolled', window.scrollY > 24)
    update()
    window.addEventListener('scroll', update, { passive: true })
  })
</script>
