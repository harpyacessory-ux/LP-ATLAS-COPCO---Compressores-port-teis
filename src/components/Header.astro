---
/**
 * Header desta LP — DESVIO da estrutura fixa (PROMPT-PADRAO-LP 4.1.1), pedido pelo
 * cliente da agência em 29/10/2026 com o mockup do topo (registro em docs/BRIEFING.md).
 *
 * Barra flutuante translúcida sobre o banner do hero, fixa no topo: logo claro, tagline
 * central e CTA verde. Ganha fundo mais opaco quando a página rola (data-scrolled).
 */
import { Image } from 'astro:assets'
import Icon from './Icon.astro'
import logo from '../assets/LOGO-light.png'
import { site } from '../data/site'
import { header, cta } from '../data/content'
---

<header class="fixed inset-x-0 top-0 z-50 pt-3 sm:pt-4 lg:pt-5" data-header>
  <div class="mx-auto max-w-page px-3 sm:px-5 lg:px-8">
    <div class="site-bar flex items-center justify-between gap-4 rounded-2xl border border-white/15 px-4 py-2.5 shadow-[0_18px_40px_-24px_rgba(0,0,0,0.7)] backdrop-blur-md sm:px-6 sm:py-3 lg:px-7">
      {/* 1. Logo claro */}
      <a href="/" class="flex shrink-0 items-center" aria-label={site.brand}>
        <Image
          src={logo}
          alt={site.brand}
          width={420}
          format="webp"
          loading="eager"
          fetchpriority="low"
          decoding="async"
          class="h-8 w-auto sm:h-10"
        />
      </a>

      {/* 2. Tagline central (some no mobile) */}
      <span class="hidden flex-1 text-center font-display text-[13px] font-semibold tracking-[0.24em] text-neutral-light uppercase lg:block xl:text-[15px]">
        {header.tagline}
      </span>

      {/* 3. CTA verde, rótulo curto no mobile */}
      <button
        type="button"
        data-cta="header-cta"
        class="btn-slave-whats inline-flex shrink-0 items-center gap-2.5 rounded-lg border border-white/20 bg-accent-orange px-4 py-2.5 font-sans text-[13px] font-bold text-neutral-light shadow-[0_8px_20px_-10px_rgba(0,0,0,0.6)] transition-colors duration-200 hover:bg-accent-orange-dark sm:px-6 sm:py-3 sm:text-[15px]"
      >
        <span class="sm:hidden">{cta.primaryShort}</span>
        <span class="hidden sm:inline">{cta.primary}</span>
        <Icon name="arrow-right" class="hidden size-4 shrink-0 sm:block" />
      </button>
    </div>
  </div>
</header>

<style>
  .site-bar {
    background-color: rgb(0 33 70 / 0.55);
    transition: background-color 300ms ease;
  }

  [data-header][data-scrolled] .site-bar {
    background-color: rgb(0 30 66 / 0.92);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-bar {
      transition: none;
    }
  }
</style>

<style is:global>
  /* O header é fixo: âncoras param abaixo dele. */
  html {
    scroll-padding-top: 6.5rem;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-header]').forEach((el) => {
    const update = () => el.toggleAttribute('data-scrolled', window.scrollY > 24)
    update()
    window.addEventListener('scroll', update, { passive: true })
  })
</script>
